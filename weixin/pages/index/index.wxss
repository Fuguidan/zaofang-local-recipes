.add-button { width: 100%; margin-bottom: 28rpx; }
.toolbar { display: flex; align-items: center; gap: 18rpx; padding: 18rpx; }
.search-input { flex: 1; min-width: 0; height: 76rpx; padding: 0 24rpx; border-radius: 999rpx; background: #f5f1ea; }
.mode-switch { display: flex; padding: 6rpx; border-radius: 999rpx; background: #eee8df; }
.mode-button { min-width: 90rpx; height: 62rpx; padding: 0 18rpx; border-radius: 999rpx; background: transparent; font-size: 24rpx; line-height: 62rpx; }
.mode-button.active { background: #fff; color: #b64122; box-shadow: 0 4rpx 12rpx rgba(0,0,0,.06); }
.summary-row { display: flex; justify-content: space-between; margin: 18rpx 4rpx 24rpx; color: var(--muted); font-size: 25rpx; }
.recipe-card { overflow: hidden; padding: 0; }
.recipe-cover, .recipe-placeholder { width: 100%; height: 400rpx; }
.recipe-placeholder, .tile-placeholder { display: flex; align-items: center; justify-content: center; background: #273129; color: #e89169; font-family: serif; font-size: 80rpx; }
.recipe-body { padding: 28rpx; }
.recipe-meta { display: flex; gap: 18rpx; align-items: center; color: var(--green-deep); font-size: 24rpx; font-weight: 650; }
.draft { margin-left: auto; padding: 8rpx 16rpx; border-radius: 999rpx; background: var(--warn); color: #85691d; }
.recipe-name { display: block; margin: 18rpx 0 12rpx; font-family: serif; font-size: 42rpx; font-weight: 700; }
.recipe-description { display: -webkit-box; overflow: hidden; color: var(--muted); font-size: 27rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.nutrition-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 22rpx 0; }
.nutrition-chip { display: inline-flex; gap: 8rpx; align-items: baseline; padding: 10rpx 15rpx; border-radius: 16rpx; background: #edf3ea; color: #3f6548; font-size: 21rpx; }
.nutrition-value { font-size: 23rpx; font-weight: 700; }
.tile-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18rpx; }
.tile-card { overflow: hidden; border: 1rpx solid var(--line); border-radius: 24rpx; background: var(--paper); }
.tile-image, .tile-placeholder { width: 100%; height: 290rpx; }
.tile-placeholder { font-size: 60rpx; }
.tile-body { padding: 20rpx; }
.tile-name { display: block; overflow: hidden; font-family: serif; font-size: 30rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.tile-meta { display: block; margin-top: 10rpx; color: var(--muted); font-size: 22rpx; }
.pagination { display: flex; align-items: center; justify-content: center; gap: 24rpx; margin-top: 34rpx; color: var(--muted); font-size: 25rpx; }
@media (min-width: 700px) { .tile-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } .recipe-cover { height: 520rpx; } }
