<view class="page" wx:if="{{recipe}}">
  <image wx:if="{{recipe.imagePath}}" class="hero-image" src="{{recipe.imagePath}}" mode="aspectFill" />
  <view wx:else class="hero-placeholder">灶</view>

  <view class="card intro-card">
    <view class="meta"><text>{{recipe.dietType}}</text><text>{{recipe.duration}} 分钟</text><text>{{recipe.difficulty}}</text></view>
    <text class="recipe-title">{{recipe.name || '待完善菜谱'}}</text>
    <text class="description">{{recipe.description || '还没有补充说明'}}</text>
    <view class="chip-row"><text class="chip" wx:for="{{recipe.tags}}" wx:key="*this">#{{item}}</text></view>
  </view>

  <view class="card" wx:if="{{nutritionChips.length}}">
    <text class="section-title">营养估算</text>
    <view class="nutrition-grid"><view class="nutrition-item" wx:for="{{nutritionChips}}" wx:key="key"><text>{{item.label}}</text><text class="nutrition-value">{{item.value}}</text></view></view>
    <view class="notice" wx:if="{{!nutritionComplete}}">部分食材缺少克数或标准食品匹配，合计仅供参考。</view>
  </view>

  <view class="card">
    <text class="section-title">食材</text>
    <view class="ingredient" wx:for="{{ingredientDetails}}" wx:key="id">
      <view><text class="ingredient-name">{{item.name}}</text><text class="food-name">{{item.foodLabel}}</text></view>
      <text>{{item.amount}} {{item.unit}}<block wx:if="{{item.grams}}"> · {{item.grams}}g</block></text>
    </view>
    <view wx:if="{{!ingredientDetails.length}}" class="muted">尚未填写食材</view>
  </view>

  <view class="card">
    <text class="section-title">制作步骤</text>
    <view class="step" wx:for="{{recipe.steps}}" wx:key="index"><text class="step-number">{{index + 1}}</text><text>{{item}}</text></view>
    <view wx:if="{{!recipe.steps.length}}" class="muted">尚未填写步骤</view>
  </view>

  <view class="button-row safe-bottom"><button class="button-ghost" bindtap="editRecipe">修改菜谱</button><button class="button-danger" bindtap="deleteRecipe">删除菜谱</button></view>
</view>
