page { height: 100vh; overflow: hidden; background: #242923; color: #fff; }
.editor-page { display: flex; height: 100vh; flex-direction: column; padding: 28rpx 26rpx calc(24rpx + env(safe-area-inset-bottom)); }
.editor-copy { padding: 8rpx 8rpx 24rpx; }
.editor-title { display: block; margin-top: 8rpx; font-family: serif; font-size: 42rpx; font-weight: 700; }
.editor-tip { display: block; margin-top: 8rpx; color: #c8cec5; font-size: 24rpx; line-height: 1.45; }
.canvas-shell { overflow: hidden; width: 100%; aspect-ratio: 1; border: 2rpx solid rgba(255,255,255,.25); border-radius: 26rpx; background: #f3eee5; }
.crop-canvas { width: 100%; height: 100%; }
.controls { padding: 24rpx 4rpx; }
.zoom-row { display: flex; align-items: center; color: #c8cec5; font-size: 20rpx; }
.zoom-slider { min-width: 0; flex: 1; }
.zoom-value { display: block; margin-bottom: 20rpx; color: #fff; font-size: 24rpx; text-align: center; }
.bottom-actions { display: flex; gap: 18rpx; margin-top: auto; }
.bottom-actions button { flex: 1; }
