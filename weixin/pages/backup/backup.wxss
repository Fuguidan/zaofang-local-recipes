.summary { display: grid; grid-template-columns: repeat(3, 1fr); text-align: center; }
.summary view { display: flex; flex-direction: column; gap: 8rpx; color: var(--muted); font-size: 23rpx; }
.summary-value { color: var(--ink); font-family: serif; font-size: 44rpx; font-weight: 700; }
.description { display: block; margin-bottom: 24rpx; line-height: 1.6; }
.path { display: block; margin: 10rpx 0 18rpx; font-size: 22rpx; word-break: break-all; }
.import-preview { margin-top: 24rpx; padding: 22rpx; border-radius: 22rpx; background: #f5f1ea; }
.preview-title { display: block; margin-bottom: 10rpx; font-size: 29rpx; font-weight: 700; }
.import-preview .field { margin-top: 20rpx; }
.danger-zone { border-color: #e5c3be; }
.danger-zone button { margin-top: 24rpx; }
