<view class="page safe-bottom">
  <view class="hero"><text class="eyebrow">收下一道新味道</text><text class="title">{{isEdit ? '修改菜谱' : '添加菜谱'}}</text></view>

  <view class="card">
    <text class="section-title">01 菜品图片与说明</text>
    <view class="image-box" bindtap="chooseImage">
      <image wx:if="{{draft.imagePath}}" class="preview-image" src="{{draft.imagePath}}" mode="aspectFill" />
      <view wx:else class="image-empty"><text>＋ 上传图片</text><text class="muted">支持相册、拍照及 Apple HEIC</text></view>
    </view>
    <view wx:if="{{draft.imagePath}}" class="button-row image-actions"><button class="button-secondary button-small" bindtap="editImage">裁剪 · 旋转 · 缩放</button><button class="button-ghost button-small" bindtap="removeImage">移除图片</button></view>
    <view wx:if="{{processingImage}}" class="notice">正在处理图片…</view>
    <view wx:if="{{imageNotice}}" class="notice {{draft.imageAiReady ? 'success-notice' : ''}}">{{imageNotice}}</view>
    <label class="field"><text class="field-label">原始说明</text><textarea class="textarea" placeholder="例如：外婆做的红烧肉，偏甜口……" value="{{draft.description}}" data-field="description" bindinput="inputField" /></label>

    <view class="ai-panel">
      <view><text class="ai-title">智能生成</text><text class="ai-subtitle">{{aiEnabled ? (aiConfigured ? '使用 ' + aiModel : '模型配置不完整') : '设置中尚未允许 AI 生成'}}</text></view>
      <view wx:if="{{thinkingSupported}}" class="thinking-switch"><button class="thinking-button {{!thinkingEnabled ? 'active' : ''}}" data-value="false" bindtap="setThinking">关闭思考</button><button class="thinking-button {{thinkingEnabled ? 'active' : ''}}" data-value="true" bindtap="setThinking">开启思考</button></view>
      <view class="button-row"><button class="button-ghost" disabled="{{generating}}" data-mode="text" bindtap="generate">仅文字生成</button><button class="button-secondary" disabled="{{generating}}" data-mode="image" bindtap="generate">图片＋文字识别</button></view>
      <view wx:if="{{aiNotice}}" class="notice">{{aiNotice}}</view>
    </view>
  </view>

  <view class="card">
    <text class="section-title">02 基本信息</text>
    <label class="field"><text class="field-label">菜名</text><input class="input" placeholder="可留空保存为待完善菜谱" value="{{draft.name}}" data-field="name" bindinput="inputField" /></label>
    <view class="two-columns">
      <label class="field"><text class="field-label">荤素分类</text><picker range="{{dietTypes}}" value="{{dietIndex}}" bindchange="dietChange"><view class="picker-box">{{draft.dietType}}</view></picker></label>
      <label class="field"><text class="field-label">难度</text><picker range="{{difficulties}}" value="{{difficultyIndex}}" bindchange="difficultyChange"><view class="picker-box">{{draft.difficulty}}</view></picker></label>
    </view>
    <label class="field"><text class="field-label">耗时（分钟）</text><input class="input" type="number" value="{{draft.duration}}" data-field="duration" bindinput="inputField" /></label>
    <label class="field"><text class="field-label">餐次</text><checkbox-group class="choice-grid" bindchange="mealChange"><label wx:for="{{meals}}" wx:key="value"><checkbox value="{{item.value}}" checked="{{item.checked}}" color="#cc4e27" />{{item.label}}</label></checkbox-group></label>
    <label class="field"><text class="field-label">口味</text><checkbox-group class="choice-grid" bindchange="flavorChange"><label wx:for="{{flavors}}" wx:key="value"><checkbox value="{{item.value}}" checked="{{item.checked}}" color="#cc4e27" />{{item.value}}</label></checkbox-group></label>
    <label class="field"><text class="field-label">自定义标签</text><input class="input" placeholder="用逗号分隔，例如：快手菜，健身餐" value="{{draft.tagsText}}" data-field="tagsText" bindinput="inputField" /></label>
  </view>

  <view class="card">
    <text class="section-title">03 食材与重量</text>
    <view class="ingredient-editor" wx:for="{{draft.ingredients}}" wx:key="id">
      <view class="item-head"><text>食材 {{index + 1}}</text><view class="mini-actions"><button data-index="{{index}}" data-direction="-1" bindtap="moveIngredient">↑</button><button data-index="{{index}}" data-direction="1" bindtap="moveIngredient">↓</button><button data-index="{{index}}" bindtap="removeIngredient">删除</button></view></view>
      <input class="input" placeholder="食材名称" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="ingredientInput" />
      <view class="triple-columns"><input class="input" placeholder="数量" value="{{item.amount}}" data-index="{{index}}" data-field="amount" bindinput="ingredientInput" /><input class="input" placeholder="单位" value="{{item.unit}}" data-index="{{index}}" data-field="unit" bindinput="ingredientInput" /><input class="input" type="digit" placeholder="克数" value="{{item.grams}}" data-index="{{index}}" data-field="grams" bindinput="ingredientInput" /></view>
      <view class="food-match"><text>{{item.food ? item.name + ' ｜ ' + item.food.name : '尚未匹配标准食品'}}</text><button class="button-ghost button-small" data-index="{{index}}" bindtap="selectFood">搜索标准库</button></view>
    </view>
    <button class="button-ghost" bindtap="addIngredient">＋ 添加食材</button>
  </view>

  <view class="card">
    <text class="section-title">04 制作步骤</text>
    <view class="step-editor" wx:for="{{draft.steps}}" wx:key="index">
      <view class="item-head"><text>步骤 {{index + 1}}</text><view class="mini-actions"><button data-index="{{index}}" data-direction="-1" bindtap="moveStep">↑</button><button data-index="{{index}}" data-direction="1" bindtap="moveStep">↓</button><button data-index="{{index}}" bindtap="removeStep">删除</button></view></view>
      <textarea class="textarea step-textarea" placeholder="描述这一步怎么做" value="{{item}}" data-index="{{index}}" bindinput="stepInput" />
    </view>
    <button class="button-ghost" bindtap="addStep">＋ 添加步骤</button>
  </view>

  <view class="button-row"><button class="button-ghost" bindtap="cancel">取消</button><button class="button-primary" bindtap="saveRecipe">保存到本机</button></view>
  <view wx:if="{{generating}}" class="loading-mask"><view class="loading-card"><text class="section-title">正在智能生成</text><text class="muted">请保持小程序在前台，原图片和文字不会因失败丢失。</text></view></view>
</view>
